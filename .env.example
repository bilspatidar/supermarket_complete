# Application & Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# Database
DB_CLIENT=sqlite
DATABASE_URL=file:database.sqlite

# Production MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=supermarket_db
MYSQL_USER=supermarket_user
MYSQL_PASSWORD=secure_password

# Authentication & Security
JWT_ACCESS_SECRET=supermarket_jwt_access_secret_production_key_2026_xyz
JWT_REFRESH_SECRET=supermarket_jwt_refresh_secret_production_key_2026_abc
JWT_EXPIRES_IN=7d

# Payment Gateways (Razorpay)
RAZORPAY_KEY_ID=rzp_test_sample_key_12345
RAZORPAY_KEY_SECRET=sample_secret_key_67890
RAZORPAY_WEBHOOK_SECRET=webhook_secret_key_12345

# WhatsApp Cloud API / Provider Integration
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_ACCESS_TOKEN=sample_whatsapp_bearer_token
WHATSAPP_PHONE_NUMBER_ID=10987654321

# Storage Driver ('local' or 'r2')
STORAGE_DRIVER=local

# Cloudflare R2 Credentials (when STORAGE_DRIVER=r2)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=
