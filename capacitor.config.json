
{
  "appId": "com.sparkhub.swastik",
  "appName": "Swastik Supermarket",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "Geolocation": {
      "permissions": [
        "location"
      ]
    },
    "SpeechRecognition": {
      "language": "en-IN"
    },
    "SplashScreen": {
    "launchShowDuration": 2000,
    "launchAutoHide": true,
    "launchFadeOutDuration": 250,
    "backgroundColor": "#000000",
    "showSpinner": false,
    "splashFullScreen": true,
    "splashImmersive": false
  },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK"
    }
  }
}
