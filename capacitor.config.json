{
  "appId": "com.sparkhub.swastik",
  "appName": "Swastik Supermarket",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "Geolocation": {
      "permissions": [
        "location"
      ]
    },
    "SpeechRecognition": {
      "language": "en-IN"
    }
  }
}
